{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@fetch/mcp-server"]
    },
    "impeccable": {
      "command": "npx",
      "args": ["-y", "impeccable"]
    },
    "stitch": {
      "command": "npx",
      "args": ["-y", "@_davideast/stitch-mcp"]
    }
  }
}
