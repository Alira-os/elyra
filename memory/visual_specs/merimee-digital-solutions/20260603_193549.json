  "delta_id": "merimee-digital-solutions-20260603_v1",
  "parent_brand_spec_version": "20260601_brand_spec_v1",
  "primary_change": "No visual evolution — BrandSpec fidelity only. Classical motion philosophy implemented with 200ms override; serif-led typographic hierarchy reinforces mission-driven positioning. Single-page Wix anchor architecture preserved in section order while enabling per-route page layouts for the Next.js migration.",
  "rationale": "Stitch MCP unavailable; preserving source brand tokens exactly. The BrandSpec motion_philosophy='classical' is honored via motion-classical classes throughout, with motion_duration=200ms overriding the classical default of 400ms (per BrandSpec override precedence). Serif heading + sans body pairing is preserved as the core brand signal. No new colors introduced; all deltas trace to existing semantic_tokens.",
  "impacted_components": [
    "button",
    "card",
    "input",
    "navigation",
    "hero",
    "footer"
  ],
  "impacted_pages": [
    "/",
    "/about",
    "/services",
    "/portfolio",
    "/contact"
  ],
  "color_delta": {
    "hero_overlay": "var(--color-on-surface)",
    "hero_overlay_opacity": "0.55",
    "card_hover_border": "var(--brand-accent)",
    "form_focus_ring": "var(--brand-accent)",
    "footer_surface": "var(--color-surface)"
  },
  "typography_delta": {
    "hero_h1_size": "5xl",
    "hero_h1_weight": "bold",
    "hero_h1_tracking": "tight",
    "section_h2_size": "3xl",
    "section_h2_weight": "semibold",
    "eyebrow_label_size": "sm",
    "eyebrow_label_weight": "semibold",
    "eyebrow_label_tracking": "widest",
    "eyebrow_label_transform": "uppercase",
    "body_lead_size": "lg"
  },
  "motion_delta": {
    "active_philosophy": "classical",
    "duration_override_ms": 200,
    "easing": "ease-out",
    "modal_spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "hover_scale": 1.02,
    "translate_offset_px": -2,
    "reduced_motion": "required"
  },
  "designer_notes": [
    "Preserve Merriweather serif headings at all levels — core brand signal for authority and timelessness.",
    "Hero overlay uses --color-on-surface at 0.55 alpha to ensure WCAG AA contrast on hero background image regardless of underlying photo brightness.",
    "Service card icons (web-design, mobile-apps, brand-messaging, build-interest) sit on --color-primary-container (#EEF2FF) tiles for subtle, classical accent.",
    "All CTAs use motion-classical with 200ms (BrandSpec override of classical default 400ms) — restrained, not flashy.",
    "Portfolio gallery uses card.elevated variant on hover; --shadow-md elevation + 1.02 scale via motion-classical.",
    "Form inputs use input.filled variant on focus with --brand-accent focus ring (WCAG-compliant 3px ring at 15% alpha).",
    "Dark mode: full_tokens strategy is already declared in BrandSpec; ensure --brand-background, --brand-text, --color-surface, --color-on-surface all flip in [data-theme='dark'].",
    "prefers-reduced-motion is mandatory: all motion-classical transforms collapse to opacity-only fades.",
    "Footer uses footer_surface semantic token to softly separate from page background without introducing a new color."
  ],
